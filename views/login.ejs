<%- include('partials/header') %>
<section class="tarjeta tarjeta-auth">
  <h1>Iniciar sesión</h1>
  <% if (errores.general) { %><div class="alerta alerta-error"><%= errores.general %></div><% } %>
  <form action="/login" method="POST" id="formLogin" novalidate>
    <label for="email">Correo electrónico</label>
    <input type="email" id="email" name="email" value="<%= datos.email || '' %>" required
           class="<%= errores.email ? 'invalido' : '' %>">
    <small class="error" data-para="email"><%= errores.email || '' %></small>

    <label for="password">Contraseña</label>
    <input type="password" id="password" name="password" required
           class="<%= errores.password ? 'invalido' : '' %>">
    <small class="error" data-para="password"><%= errores.password || '' %></small>

    <button type="submit" class="btn">Entrar</button>
  </form>
  <p class="pie">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
</section>
<script src="/validar.js"></script>
<%- include('partials/footer') %>
