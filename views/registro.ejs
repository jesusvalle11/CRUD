<%- include('partials/header') %>
<section class="tarjeta tarjeta-auth">
  <h1>Crear cuenta</h1>
  <form action="/registro" method="POST" id="formRegistro" novalidate>
    <label for="nombre">Nombre completo</label>
    <input type="text" id="nombre" name="nombre" value="<%= datos.nombre || '' %>" maxlength="50" required
           class="<%= errores.nombre ? 'invalido' : '' %>">
    <small class="error" data-para="nombre"><%= errores.nombre || '' %></small>

    <label for="email">Correo electrónico</label>
    <input type="email" id="email" name="email" value="<%= datos.email || '' %>" maxlength="100" required
           class="<%= errores.email ? 'invalido' : '' %>">
    <small class="error" data-para="email"><%= errores.email || '' %></small>

    <label for="password">Contraseña</label>
    <input type="password" id="password" name="password" maxlength="64" required
           class="<%= errores.password ? 'invalido' : '' %>">
    <small class="ayuda">Mínimo 8 caracteres, con mayúscula, minúscula y número.</small>
    <small class="error" data-para="password"><%= errores.password || '' %></small>

    <label for="confirmar">Confirmar contraseña</label>
    <input type="password" id="confirmar" name="confirmar" maxlength="64" required
           class="<%= errores.confirmar ? 'invalido' : '' %>">
    <small class="error" data-para="confirmar"><%= errores.confirmar || '' %></small>

    <button type="submit" class="btn">Registrarme</button>
  </form>
  <p class="pie">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
</section>
<script src="/validar.js"></script>
<%- include('partials/footer') %>
